# Copy to .env and fill in. Secrets are provided via the host (Render dashboard).
NODE_ENV=development
PORT=8081

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/meetingspot_dev?schema=public"

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET=
# Key material for AES-256-GCM derivation (used to encrypt user_b contact)
ENCRYPTION_KEY=

# Google Maps (geocoding + places) and OAuth
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun (password reset + invite emails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Twilio (optional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Set true to bypass premium gating in non-production
PREMIUM_BYPASS=false
PROFILE_PICTURES_DIR=uploads/profile-pictures
