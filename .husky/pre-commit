#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit hooks..."

# Temporarily disabled lint check
echo "Skipping lint: Temporarily disabled"

# Check if format script exists before running
if npm run | grep -q "^  format$"; then
  npm run format || echo "Format script failed but continuing anyway"
else
  echo "Skipping format: Script not found"
fi

# Temporarily disabled type checking
echo "Skipping type checking: Temporarily disabled"

echo "Pre-commit hooks completed successfully!" 