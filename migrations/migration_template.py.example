def downgrade():
    """
    Revert the changes made in the upgrade function.

    IMPORTANT:
    1. Make downgrades as safe as upgrades
    2. Consider if data migrations can be reverted
    3. Include proper error handling
    """
    # Example: Removing the column safely
    if table_exists('users'):
        if column_exists('users', 'new_column_name'):
            # Drop the index first
            if index_exists('users', 'ix_users_new_column_name'):
                logger.info("Dropping index ix_users_new_column_name")
                op.drop_index('ix_users_new_column_name', table_name='users')

            logger.info("Removing new_column_name from users table")
            op.drop_column('users', 'new_column_name')
            logger.info("Successfully removed new_column_name from users table")
        else:
            logger.info("Column new_column_name does not exist in users table")
    else:
        logger.warning("Table users does not exist, skipping column removal")
